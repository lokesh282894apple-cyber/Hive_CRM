# Example env — copy to .env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SEED_ADMIN_EMAIL=admin@hiveschool.in
SEED_ADMIN_PASSWORD=
SEED_COUNSELOR_EMAIL=counsellor@hiveschool.in
SEED_COUNSELOR_PASSWORD=
SEED_INTERVIEWER_EMAIL=interviewer@hiveschool.in
SEED_INTERVIEWER_PASSWORD=

# Google Calendar + Meet (shared admissions calendar)
# Enable Calendar API, create OAuth client, then: npm run google:oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Optional: Postgres URL for npm run db:migrate
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Public app URL (required for Twilio webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Website / track API auth (required in production)
CRM_TRACK_API_KEY=
CRON_SECRET=

# Twilio click-to-call (rings counselor, then bridges to lead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp — AiSensy (preferred) or Meta Cloud API
AISENSY_API_KEY=
AISENSY_CAMPAIGN_URL=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=HiveSchool Admissions <admissions@hiveschool.in>

# Meta Lead Ads webhook
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Read AI webhook
READ_AI_WEBHOOK_SECRET=

# SIM dialer: park unknown numbers (default true)
# SIM_CALLS_PARK_UNKNOWN=true
